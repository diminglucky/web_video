WEB_VIDEO_SERVER_PORT=8787
WEB_VIDEO_RENDER_BASE_URL=http://127.0.0.1:5174
# Windows: C:\Program Files\Google\Chrome\Application\chrome.exe
# macOS: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Linux: /usr/bin/google-chrome
WEB_VIDEO_CHROME_PATH=
WEB_VIDEO_RENDER_FPS=30
WEB_VIDEO_RENDER_SETTLE_MS=1400

# Local/free providers:
#   edge-tts: free, no API key, requires `edge-tts` executable in PATH
#   windows-sapi: Windows built-in offline voices, no API key
#   say: macOS offline, requires `say` and `ffmpeg`
#   piper: true local model, set PIPER_BIN and PIPER_MODEL
#   openai: set OPENAI_API_KEY on backend only
WEB_VIDEO_TTS_PROVIDER=windows-sapi
WEB_VIDEO_TTS_VOICE=Microsoft Huihui Desktop - Chinese (Simplified)
WEB_VIDEO_TTS_RATE=0
WEB_VIDEO_TTS_VOLUME=100
WEB_VIDEO_TTS_FORMAT=mp3
WEB_VIDEO_TTS_FALLBACK=none
WEB_VIDEO_TTS_FALLBACK_VOICE=Tingting

# Script generation:
#   llm-required: real LLM call required; fail if API is unavailable
#   llm-auto: try LLM first, then local rule fallback
#   local: local rule draft only
WEB_VIDEO_SCRIPT_PROVIDER=llm-required
WEB_VIDEO_LLM_MODEL=gpt-4o-mini
WEB_VIDEO_LLM_TIMEOUT_MS=45000

# OpenAI TTS backend config (optional)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TTS_BASE_URL=
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Piper offline model config (optional)
PIPER_BIN=piper
PIPER_MODEL=
